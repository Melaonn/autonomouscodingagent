# Local loopback access establishes an administrator session automatically.
PORT=4310
HOST=127.0.0.1
PUBLIC_URL=http://localhost:4310
# Production uses PostgreSQL; absent DATABASE_URL uses persistent local PGlite.
DATABASE_URL=
DATA_DIR=.runtime
SESSION_SECRET=replace-with-at-least-32-random-characters
LOCAL_MCP_TOKEN=replace-with-a-second-random-secret-of-at-least-32-characters
# Register a GitHub OAuth App with callback URL:
# http://localhost:4310/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Comma-separated GitHub usernames. Production requires both allowlists.
GITHUB_ALLOWED_USERS=
GITHUB_ADMIN_USERS=
# Optional production alternative: a GitHub App installation may own repository automation.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
