# Local development is loopback-only; the login uses this explicit operator token.
PORT=4310
HOST=127.0.0.1
PUBLIC_URL=http://localhost:5173
DEV_AUTH_TOKEN=replace-with-a-long-random-local-token
# Production uses PostgreSQL; absent DATABASE_URL uses persistent local PGlite.
DATABASE_URL=
DATA_DIR=.runtime
SESSION_SECRET=replace-with-at-least-32-random-characters
RUNNER_URL=http://127.0.0.1:4311
RUNNER_TOKEN=replace-with-at-least-32-random-characters
# GitHub user login is separate from repository installation credentials.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=
GITHUB_ADMIN_USERS=
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
# Optional fine-grained token for a controlled test repository.
GITHUB_TOKEN=
# Dedicated agent auth folders; never mount personal home directories.
CODEX_AUTH_DIR=
CLAUDE_AUTH_DIR=
WORKER_IMAGE=sdlc-worker:local
MAX_ACTIVE_RUNS=2
