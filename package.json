{
  "name": "sdlc-control-plane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "format": "prettier --write \"{apps,shared,tests}/**/*.{ts,tsx,css}\" \"*.{js,ts,json}\"",
    "format:check": "prettier --check \"{apps,shared,tests}/**/*.{ts,tsx,css}\" \"*.{js,ts,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "evaluate": "npm run build -w apps/server && node apps/server/dist/eval-main.js",
    "benchmark:run": "npm run build -w apps/server && node apps/server/dist/paired-run-main.js",
    "check": "npm run format:check && npm run typecheck && npm run lint && npm test && npm run build",
    "start": "node apps/server/dist/index.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.0.2",
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "cross-spawn": "^7.0.6",
    "dotenv": "^17.2.3",
    "fastify": "^5.12.4",
    "lucide-react": "^0.468.0",
    "minimatch": "^10.2.6",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.8",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vitest": "^4.0.0"
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 120
  },
  "engines": {
    "node": ">=24"
  }
}
